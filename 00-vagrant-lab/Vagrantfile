Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  nodes = {
    "control-01" => { ip: "192.168.100.10", memory: 5632, cpus: 2, disk: "30GB" },
    "control-02" => { ip: "192.168.100.11", memory: 5632, cpus: 2, disk: "30GB" },
    "control-03" => { ip: "192.168.100.12", memory: 5632, cpus: 2, disk: "30GB" },
    "compute-01" => { ip: "192.168.100.20", memory: 6144, cpus: 2, disk: "60GB" },
    "compute-02" => { ip: "192.168.100.21", memory: 6144, cpus: 2, disk: "60GB" }
  }

  nodes.each do |name, specs|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: specs[:ip]
      node.vm.network "private_network", 
                      allow_unconfigured: true, 
                      vnetmode: "custom", 
                      vnet: "vmnet8"
      
      node.vm.provider "vmware_desktop" do |v|
        v.memory = specs[:memory]
        v.cpus = specs[:cpus]
        v.linked_clone = false
        v.gui = false
      end
      
    end
  end
end